APP_NAME="Pesticides Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel MySQL databases are always local to the same server; host is
# almost always "localhost", and both DB name and DB user are prefixed
# with your cPanel username (e.g. cpuser_pesticides / cpuser_pmsuser).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_pesticides
DB_USERNAME=cpuser_pmsuser
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# AutoSSL is enabled on the domain (see runbook) so cookies can be
# marked secure-only.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No queued jobs exist in this app (CheckExpiringBatches runs via the
# scheduler, not a queue) — sync avoids needing a persistent worker
# process, which most shared-hosting plans can't run anyway.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# cPanel's own mail service — replace with your domain's real mailbox.
# Under Email Accounts > Connect Devices in cPanel you can copy the
# exact outgoing (SMTP) settings for your domain.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
